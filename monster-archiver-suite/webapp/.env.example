# All optional — sensible local defaults are built in. Copy this file to .env
# only if you need to override something (e.g. a different Ollama model/port).

# OLLAMA_BASE_URL: where your local Ollama server's OpenAI-compatible API lives.
# Default: http://localhost:11434/v1
# OLLAMA_BASE_URL="http://localhost:11434/v1"

# OLLAMA_MODEL: which locally-pulled Ollama model to use for lyric translation.
# Default: gemma4:12b — pull it with `ollama pull gemma4:12b`, or point this at
# any other chat model you've pulled.
# OLLAMA_MODEL="gemma4:12b"

# PORT: which port the app listens on. Default: 3000
# PORT=3000

# GEMINI_API_KEY: Required for Google Gemini Pro translations via AI Studio.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HOST: which network interface to bind to. Default: 127.0.0.1 (localhost only —
# nothing is exposed to your network). Set to 0.0.0.0 only if you deliberately
# want other devices on your LAN to reach this app.
# HOST="127.0.0.1"
