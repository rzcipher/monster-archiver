{
  "name": "monster-archiver-suite",
  "private": true,
  "version": "18.4.0",
  "type": "module",
  "scripts": {
    "dev": "cd monster-archiver-suite/webapp && tsx server.ts",
    "build": "cd monster-archiver-suite/webapp && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "cd monster-archiver-suite/webapp && node dist/server.cjs",
    "clean": "cd monster-archiver-suite/webapp && rm -rf dist server.js",
    "lint": "cd monster-archiver-suite/webapp && tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "idb-keyval": "^6.3.0",
    "wavesurfer.js": "^7.8.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
